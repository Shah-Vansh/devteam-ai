# DevTeam AI configuration template.
# Copy to .env in the repo root (the only .env in this project) and fill in the secrets.
# Backend, MCP servers and frontend all read that single root .env.

# ---------- Shared ----------
APP_ENV=development
LOG_LEVEL=INFO

# ---------- Backend ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Relative paths are resolved from the repo root
DATABASE_URL=sqlite:///./data/devteam.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
WORKSPACES_DIR=./workspaces
CORS_ORIGINS=http://localhost:5173

# ---------- LLM (provider-agnostic) ----------
# Provider name, key and model are chosen in Phase 1 by benchmark
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Optional: only for OpenAI-compatible endpoints
LLM_BASE_URL=
# Optional: cap on each answer's length in tokens (reasoning included). Empty = provider default.
LLM_MAX_OUTPUT_TOKENS=
# Optional, reasoning models only (gpt-oss): low, medium or high. Empty = provider default.
# "low" leaves more of a small token budget for the actual answer.
LLM_REASONING_EFFORT=

# ---------- Code execution sandbox ----------
# e2b = run tests in a remote microVM, static_only = never execute, only analyse
EXECUTOR=e2b
E2B_API_KEY=
SANDBOX_TIMEOUT_SECONDS=120

# ---------- Commits in generated projects ----------
# Author of the local commit made after tests pass and you approve. Never pushed anywhere.
COMMIT_AUTHOR_NAME=DevTeam AI
COMMIT_AUTHOR_EMAIL=devteam-ai@localhost

# ---------- Workflow limits ----------
MAX_REVIEW_ROUNDS=2
MAX_FIX_ROUNDS=2
MAX_LLM_CALLS_PER_RUN=40

# ---------- Frontend ----------
# Only VITE_ variables reach the browser. Never put a secret here.
VITE_API_BASE_URL=http://127.0.0.1:8000
